@page "/"
@implements IDisposable
@inject LispRuntime Lisp
@inject IJSRuntime JS

<PageTitle>Lisp Blocks</PageTitle>

<h1>🧩 Lisp Blocks — 괄호 없이 블록으로 Common Lisp</h1>

@if (!_ready)
{
    <p class="status"><em>Lisp 코어 로딩 중… (dotcl.core ~5MB)</em></p>
}

<div class="workspace">
    <div id="blockly" class="blockly"></div>
</div>
<p class="hint">💡 블록을 <b>우클릭 → “이 블록만 평가”</b> 하면 그 부분식만 즉시 계산합니다 (REPL 처럼). 모든 게 식(expression)이니까요.</p>

<div class="controls">
    <button class="run" @onclick="Run" disabled="@(!_ready)">▶ 실행</button>
    <button class="example" @onclick='() => LoadExample("square")' disabled="@(!_ready)">예제: 함수</button>
    <button class="example" @onclick='() => LoadExample("list")' disabled="@(!_ready)">예제: 리스트·인용</button>
    <button class="example" @onclick='() => LoadExample("fact")' disabled="@(!_ready)">예제: 재귀(팩토리얼)</button>
    <button class="example" @onclick='() => LoadExample("fib")' disabled="@(!_ready)">예제: 재귀(피보나치)</button>
    <button class="example" @onclick='() => LoadExample("letex")' disabled="@(!_ready)">예제: let(다중 바인딩)</button>
</div>

<div class="panes">
    <div class="pane">
        <h3>@(_partial ? "평가한 부분식" : "생성된 Lisp")</h3>
        <pre id="code">@_code</pre>
    </div>
    <div class="pane">
        <h3>결과</h3>
        <pre id="out">@_output</pre>
    </div>
</div>

@code {
    private bool _ready;
    private string _code = "";
    private string _output = "";
    private bool _partial;
    private bool _injected;
    private DotNetObjectReference<Home>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        await Lisp.EnsureReadyAsync();
        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blockly 는 DOM(#blockly)이 그려진 뒤 주입한다. .NET 참조를 넘겨 우클릭 평가를 연결.
        if (_ready && !_injected)
        {
            _injected = true;
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("lispBlocks.init", "blockly", _selfRef);
        }
    }

    private async Task Run()
    {
        _partial = false;
        _code = await JS.InvokeAsync<string>("lispBlocks.getCode");
        Evaluate(_code);
    }

    // Blockly 우클릭 "이 블록만 평가" → JS 가 호출 (부분식 코드 문자열 전달)
    [JSInvokable]
    public void EvalBlock(string code)
    {
        _partial = true;
        _code = code;
        Evaluate(code);
        StateHasChanged();
    }

    private void Evaluate(string code)
    {
        try { _output = Lisp.Eval(code); }
        catch (Exception ex) { _output = "ERROR: " + ex.Message; }
    }

    private async Task LoadExample(string name)
    {
        _partial = false;
        await JS.InvokeVoidAsync("lispBlocks.loadExample", name);
    }

    public void Dispose() => _selfRef?.Dispose();
}
