@page "/"
@implements IDisposable
@inject LispRuntime Lisp
@inject IJSRuntime JS

<PageTitle>Lisp Blocks</PageTitle>

<h1>🧩 Lisp Blocks — 괄호 없이 블록으로 Common Lisp</h1>

@if (!_ready)
{
    <p class="status"><em>Lisp 코어 로딩 중… (dotcl.core ~5MB)</em></p>
}

<div class="workspace">
    <div id="blockly" class="blockly"></div>
</div>
<p class="hint">💡 블록을 <b>우클릭 → “이 블록만 평가”</b> 하면 그 부분식만 즉시 계산합니다 (REPL 처럼). 모든 게 식(expression)이니까요.</p>

<div class="controls">
    <button class="run" @onclick="Run" disabled="@(!_ready)">▶ 실행</button>
    <label>예제:
        <select @onchange="OnPickExample" disabled="@(!_ready)">
            <option value="">— 선택 —</option>
            @foreach (var (key, label) in _examples)
            {
                <option value="@key">@label</option>
            }
        </select>
    </label>
</div>

<div class="panes">
    <div class="pane">
        <h3>@(_partial ? "평가한 부분식" : "생성된 Lisp")</h3>
        <pre id="code">@_code</pre>
    </div>
    <div class="pane">
        <h3>결과</h3>
        <pre id="out">@_output</pre>
    </div>
</div>

<div class="io">
    <h3>Lisp ⇄ 블록 — 코드가 곧 저장 형식</h3>
    <p class="hint">Lisp 를 붙여넣고 <b>블록으로</b>, 또는 블록을 <b>Lisp로</b>. 좌표는 각 최상위 폼 위 <code>;; @@block x y</code> 주석에 남습니다(여전히 유효한 Lisp).</p>
    <textarea id="io" @bind="_ioText" rows="7" class="io-text" placeholder="(defun sq (n) (* n n))&#10;(print (sq 9))"></textarea>
    <div class="io-buttons">
        <button @onclick="ToBlocks" disabled="@(!_ready)">⬅ 블록으로</button>
        <button @onclick="ToLisp" disabled="@(!_ready)">Lisp로 저장 ➡</button>
    </div>
</div>

@code {
    private bool _ready;
    private string _code = "";
    private string _output = "";
    private bool _partial;
    private bool _injected;
    private DotNetObjectReference<Home>? _selfRef;

    protected override async Task OnInitializedAsync()
    {
        await Lisp.EnsureReadyAsync();
        _ready = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blockly 는 DOM(#blockly)이 그려진 뒤 주입한다. .NET 참조를 넘겨 우클릭 평가를 연결.
        if (_ready && !_injected)
        {
            _injected = true;
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("lispBlocks.init", "blockly", _selfRef);
        }
    }

    private async Task Run()
    {
        _partial = false;
        _code = await JS.InvokeAsync<string>("lispBlocks.getCode");
        Evaluate(_code);
    }

    // Blockly 우클릭 "이 블록만 평가" → JS 가 호출 (부분식 코드 문자열 전달)
    [JSInvokable]
    public void EvalBlock(string code)
    {
        _partial = true;
        _code = code;
        Evaluate(code);
        StateHasChanged();
    }

    private void Evaluate(string code)
    {
        try { _output = Lisp.Eval(code); }
        catch (Exception ex) { _output = "ERROR: " + ex.Message; }
    }

    private readonly (string Key, string Label)[] _examples =
    {
        ("square",    "함수 (defun square)"),
        ("list",      "리스트·인용 (코드=데이터)"),
        ("fact",      "재귀 — 팩토리얼"),
        ("fib",       "재귀 — 피보나치"),
        ("letex",     "let — 다중 바인딩"),
        ("strings",   "문자열"),
        ("cond",      "조건 (if)"),
        ("listops",   "리스트 조작 (first/rest/cons)"),
        ("constants", "명명 상수 (t/nil/pi)"),
    };

    private async Task OnPickExample(ChangeEventArgs e)
    {
        var name = e.Value?.ToString();
        if (!string.IsNullOrEmpty(name)) await LoadExample(name);
    }

    private async Task LoadExample(string name)
    {
        _partial = false;
        await JS.InvokeVoidAsync("lispBlocks.loadExample", name);
    }

    private string _ioText = "";

    private async Task ToBlocks()
    {
        try { await JS.InvokeVoidAsync("lispBlocks.loadCode", _ioText); _output = "블록으로 불러왔습니다."; }
        catch (Exception ex) { _output = "PARSE ERROR: " + ex.Message; }
    }

    private async Task ToLisp() => _ioText = await JS.InvokeAsync<string>("lispBlocks.saveCode");

    public void Dispose() => _selfRef?.Dispose();
}
